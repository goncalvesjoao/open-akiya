{
  "name": "open-akiya",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint src *.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Explore akiya listings locally with a durable desktop import worker.",
  "author": "Open Akiya contributors",
  "license": "MIT",
  "main": "out/main/index.cjs",
  "build": {
    "appId": "org.openakiya.desktop",
    "productName": "Open Akiya",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
